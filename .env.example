# docker compose için örnek ortam değişkenleri.
# Kopyala: cp .env.example .env

# Panelin host'ta açılacağı port
PORT=4141

# Ajanların üzerinde çalışacağı hedef proje dizini (host yolu)
TARGET_DIR=./target

# Anthropic'e doğrudan bağlanmak için (boş bırakılırsa Claude Code oturumu aranır)
ANTHROPIC_API_KEY=

# provider=ollama gibi özel bir baseUrl kullanan config'ler için
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# TFS modu: kişisel erişim anahtarı (boş bırakılırsa panelde Ayarlar → TFS modu'ndan girilir)
KURMAY_TFS_TOKEN=
