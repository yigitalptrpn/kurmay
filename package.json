{
  "name": "kurmay-ai",
  "version": "0.1.6",
  "description": "Md tanımlı ajanları (Analist / Saha Timi / Teftiş) deterministik bir iş akışıyla koordine eden orkestratör",
  "type": "module",
  "bin": {
    "kurmay": "bin/kurmay.js"
  },
  "files": [
    "bin",
    "dist",
    "ui",
    ".claude/agents",
    ".claude/rules",
    ".claude/skills",
    ".claude/hooks",
    "config.json",
    "config.hooks.example.json",
    "config.microservices.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yigitalptrpn/kurmay.git"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "serve": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "@anthropic-ai/sdk": "^0.110.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
